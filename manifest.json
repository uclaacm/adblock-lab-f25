{
    "manifest_version": 3,
    "name": "Demo Ad Blocker",
    "version": "1.1",
    "description": "Demo Adblocker made by ACM Cyber",
    "permissions": [
        "declarativeNetRequest",
        "storage"
    ],
    "action": {
        "default_popup": "popup.html"
    },
    "content_scripts": [
        {
            "matches": ["*://*.cnn.com/*"],
            "js": ["blockcnn.js"]
        }
    ],
    "declarative_net_request" : {
        "rule_resources" : [
            {
                "id" : "ruleset",
                "enabled" : true,
                "path" : "rules.json"
            }
        ]
    },
    "host_permissions" : ["<all_urls>"]
  }

  